# ---- Required in production ----------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=0
# Hostnames of both apps, comma separated
ALLOWED_HOSTS=admin.yourchurch.org,members.yourchurch.org,localhost
CSRF_TRUSTED_ORIGINS=https://admin.yourchurch.org,https://members.yourchurch.org

# ---- Database (PostgreSQL) -------------------------------------------------
# docker-compose builds DATABASE_URL from these:
POSTGRES_DB=ecclesia
POSTGRES_USER=ecclesia
POSTGRES_PASSWORD=change-me-too
# Outside docker-compose, set it directly:
# DATABASE_URL=postgres://ecclesia:password@localhost:5432/ecclesia
# DB_SSL_REQUIRE=1          # for managed databases that require SSL

# ---- First start -----------------------------------------------------------
# Country for local defaults (currency, payroll deductions). KE = Kenya.
CHURCH_COUNTRY=KE
# Creates this administrator on first start if it doesn't exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password
ADMIN_EMAIL=

# ---- Locale & behaviour ----------------------------------------------------
TIME_ZONE=Africa/Nairobi
SESSION_HOURS=12
MAX_UPLOAD_MB=15
SERMON_MAX_UPLOAD_MB=300
# Set to 0 only if you serve the apps over plain HTTP (not recommended)
SECURE_COOKIES=1
WEB_CONCURRENCY=3

# ---- Optional: S3-compatible storage for uploads ---------------------------
# Needed when the two apps run on different servers (e.g. separate cloud services).
# S3_BUCKET=ecclesia-files
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
