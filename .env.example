# ---- Required in production ----------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=0
# Hostnames of both apps, comma separated
ALLOWED_HOSTS=admin.yourchurch.org,members.yourchurch.org,localhost
CSRF_TRUSTED_ORIGINS=https://admin.yourchurch.org,https://members.yourchurch.org

# ---- Database (PostgreSQL) -------------------------------------------------
# docker-compose builds DATABASE_URL from these:
POSTGRES_DB=ecclesia
POSTGRES_USER=ecclesia
POSTGRES_PASSWORD=change-me-too
# Outside docker-compose, set it directly:
# DATABASE_URL=postgres://ecclesia:password@localhost:5432/ecclesia
# DB_SSL_REQUIRE=1          # for managed databases that require SSL

# ---- First start -----------------------------------------------------------
# Country for local defaults (currency, payroll deductions). KE = Kenya.
CHURCH_COUNTRY=KE
# Creates this administrator on first start if it doesn't exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password
ADMIN_EMAIL=

# ---- Locale & behaviour ----------------------------------------------------
TIME_ZONE=Africa/Nairobi
SESSION_HOURS=12
MAX_UPLOAD_MB=15
SERMON_MAX_UPLOAD_MB=300
# Set to 0 only if you serve the apps over plain HTTP (not recommended)
SECURE_COOKIES=1
WEB_CONCURRENCY=3

# ---- Optional: S3-compatible storage for uploads ---------------------------
# Needed when the two apps run on different servers (e.g. separate cloud services).
# S3_BUCKET=ecclesia-files
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Optional: public demo server ------------------------------------------
# Loads the sample Nairobi church on first start, shows one-click demo logins and
# blocks password/login changes. Never turn this on for a real church.
# Reset the demo nightly, e.g. from cron: docker compose exec -T admin python manage.py reset_demo
# ECCLESIA_DEMO_MODE=1
# ECCLESIA_DEMO_PASSWORD=ChurchDemo-2026

# --- Linked bank accounts: live M-Pesa Paybill / Till (optional) -------------
# Receiving payments needs no keys. These only let "Link account" register the
# payment address with Safaricom from inside Ecclesia (Daraja app credentials).
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_ENVIRONMENT=production   # or sandbox for testing
# MPESA_ALLOWED_IPS=             # optional comma-separated list of Safaricom addresses

# --- Churches and the platform console -----------------------------------------
# Every church has its own private space, reached at <app address>/church/<name>/.
# On a brand-new single-church server, create the first church automatically and
# serve it at the plain addresses too (it uses ADMIN_USERNAME / ADMIN_PASSWORD):
# ECCLESIA_DEFAULT_CHURCH=main
# CHURCH_NAME=Your Church
# The platform super admin (signs in at <admin app>/platform/). If unset, ADMIN_* is used.
# PLATFORM_ADMIN_USERNAME=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_EMAIL=
# Optional, for the links the console shows:
# ADMIN_APP_URL=https://admin.example.org
# MEMBERS_APP_URL=https://members.example.org

# --- Email, for "Forgot password" --------------------------------------------
# Any SMTP service: Gmail (with an app password), Brevo, Zoho, Mailgun...
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Ecclesia <you@gmail.com>

# Render's free plan sleeps; set this once the admin app is on an always-on plan
# (removes the warning on the live M-Pesa page).
# ALWAYS_ON=1
