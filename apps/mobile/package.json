{
  "name": "ecclesia-connect",
  "version": "1.1.0",
  "private": true,
  "description": "Ecclesia Connect — the members app for Android and iOS. A product of Pizza Technologies.",
  "author": "Pizza Technologies",
  "license": "MIT",
  "scripts": {
    "configure": "node scripts/configure.js",
    "assets": "capacitor-assets generate --android --ios --assetPath resources --iconBackgroundColor \"#0b1d51\" --iconBackgroundColorDark \"#0b1d51\" --splashBackgroundColor \"#0b1d51\" --splashBackgroundColorDark \"#071541\"",
    "sync": "npm run configure && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "npm run sync && cd android && ./gradlew assembleDebug",
    "build:android:release": "npm run sync && cd android && ./gradlew bundleRelease assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.6.0"
  }
}
